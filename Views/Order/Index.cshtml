@using Cucina_De_Corazon.ViewModels
@model OrderViewModel
@{
	ViewData["Title"] = "NewOrder";
}
<div class="container mt-5 h-100 w-100">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }
	<div class="card shadow border-0 rounded-4" style="max-height:90% !important; min-height: 90%">
		<div class="w-100 bg-orange rounded-top position-relative">
			<h3 class="fw-bold text-white text-center m-3">New Order</h3>
			<div class="position-absolute top-0 start-0 pt-3 p-2">
				<div class="d-flex flex-row gap-2 text-white">
					<h5>Step</h5>
					<h5 id="Step">1</h5>
					<h5>of 4</h5>
				</div>
			</div>
			<div class="position-absolute top-0 end-0 pt-3 p-2">
				<div class="d-flex flex-row gap-2 text-white">
					<button class="btn btn-light fw-bold" id="btnBack" type="button" disabled>Back</button>
                    <button class="btn btn-light fw-bold" id="btnNext" type="button" disabled>Next</button>
				</div>
			</div>
		</div>
        @* Display PAGES *@
        <form asp-action="AddOrder" asp-controller="Order" method="post" class="h-100 w-100">
            <div class="p-4 h-100 w-100" id="pages">
                <!-- STEP 1 : ORDER / CUSTOMER -->
                <div id="1" class=" h-100 w-100">
                    <h4 class="mb-3">Customer Information</h4>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Customer Name</label>
                            <input class="form-control" asp-for="Order.CustomerName" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" asp-for="Order.Email"/>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Contact Number</label>
                            <input class="form-control" asp-for="Order.ContactNumber" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Alternate Contact</label>
                            <input class="form-control" asp-for="Order.AlternateContactNumber" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Address</label>
                            <textarea class="form-control" asp-for="Order.CustomerAddress"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Special Request</label>
                            <textarea class="form-control" asp-for="Order.SpecialRequest"></textarea>
                        </div>
                    </div>
                </div>

                <!-- STEP 2 : EVENT DETAILS -->
                <div id="2" class="visually-hidden h-100 w-100">
                    <h4 class="mb-3">Event Details</h4>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Event Type</label>
                            <input class="form-control" asp-for="Order.EventDetails.EventType"/>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Theme</label>
                            <input class="form-control" asp-for="Order.EventDetails.Theme" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Event Date</label>
                            <input type="date" class="form-control" asp-for="Order.EventDetails.EventDate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Event Time</label>
                            <input type="time" class="form-control" asp-for="Order.EventDetails.EventTime" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Event Address</label>
                            <textarea class="form-control" asp-for="Order.EventDetails.EventAddress"></textarea>
                        </div>
                    </div>
                </div>

                <!-- STEP 3 : ORDER PRODUCTS -->
                <div id="3" class="visually-hidden h-100 w-100">
                    <h4 class="mb-1">Order Products     -    By 5pax</h4>

                    <div class="row">
                        <!-- LEFT: Products -->
                        <div class="col-8">
                            <div style="max-height: 65vh; overflow-y: auto; overflow-x: hidden">
                                <div class="row">
                                    @foreach (var p in Model.Products)
                                    {
                                        <div class="col-lg-3 col-md-4">
                                            <div class="d-flex p-1 w-100 h-100">
                                                <div class="card food-card shadow-sm w-100 h-100">
                                                    <img src="~/images/@(p.ProductName).png"
                                                            class="card-img-top rounded-top"
                                                            alt="@p.ProductName"
                                                            style="height: 100px; object-fit: cover;">
                                                    <div class="card-body text-center d-flex flex-column justify-content-between">
                                                        <div>
                                                            <h5 class="card-title fw-bold">@p.ProductName</h5>
                                                        </div>
                                                        <div>
                                                            <p class="card-text text-dark fw-semibold">₱@p.ProductPrice</p>
                                                            <button type="button"
                                                                    class="btn btn-warning w-100 order-btn"
                                                                    data-id="@p.ProductId"
                                                                    data-name="@p.ProductName"
                                                                    data-price="@p.ProductPrice">
                                                                Add
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Receipt -->
                        <div class="col-4">
                            <div class="card shadow-sm">
                                <div class="card-header bg-dark text-white">
                                    <h5 class="mb-0">Order Summary</h5>
                                </div>

                                <div class="card-body p-2" id="receiptBody" style="max-height: 65vh; overflow-y: auto;">
                                    <p class="text-muted text-center" id="emptyReceipt">No items added</p>
                                </div>
                                <!-- Hidden inputs go here -->
                                <div id="orderItemsInputs">

                                </div>
                                <div class="card-footer">
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>Total</span>
                                        <span id="totalAmount">₱0.00</span>
                                    </div>
                                    <button class="btn btn-success w-100 mt-2" type="button" id="ResetOrder">Reset Items</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 4 : PAYMENT -->
                <div id="4" class="visually-hidden h-100 w-100">
                    <div class="m-0 p-0 position-relative">
                        <h4 class="mb-3">Payment</h4>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Payment Method</label>
                                <select class="form-select" asp-for="Order.Payments.PaymentMethod">
                                    <option>Cash</option>
                                    <option>Bank Transfer</option>
                                    <option>Paymaya</option>
                                    <option>Gcash</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Reference Number</label>
                                <input class="form-control" asp-for="Order.Payments.ReferenceNumber"/>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Payment Amount</label>
                                <input type="number" step="0.01" class="form-control" asp-for="Order.Payments.PaymentAmount" id="PaymentAmount" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Payment Status</label>
                                <select class="form-select" asp-for="Order.Payments.PaymentStatus">
                                    <option>Pending</option>
                                    <option>Paid</option>
                                </select>
                            </div>
                        </div>
                        <div class="position-absolute end-0 bottom-0">
                            <button type="submit" class="btn btn-success w-100 mt-2">
                                Confirm Order
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

	</div>

</div>
@section Scripts {
	<script>
		$(document).ready(function () {

			var currentPage = 1;
			var totalPages = $("#pages").children("div").length;

			updateButtons();

			$("#btnNext").on("click", function () {
				if (currentPage < totalPages) {
					showPage(currentPage + 1);
				}
			});

			$("#btnBack").on("click", function () {
				if (currentPage > 1) {
					showPage(currentPage - 1);
				}
			});

			function showPage(pageNumber) {
				$("#pages > div").addClass("visually-hidden");
				$("#" + pageNumber).removeClass("visually-hidden");
				$("#Step").text(pageNumber);
				currentPage = pageNumber;
				updateButtons();
			}

			function updateButtons() {
				$("#btnBack").prop("disabled", currentPage === 1);
				$("#btnNext").prop("disabled", currentPage === totalPages);
			}

		});

        let orderItems = {};
        let index = 0;
        $("#ResetOrder").on("click", function() {
            if (confirm("Are you sure you want to reset the order?")) {
                orderItems = {};
                index = 0;
                $("#receiptBody").empty();
                $("#receiptBody").html('<p class="text-muted text-center" id="emptyReceipt">No items added</p>');
                $("#orderItemsInputs").empty();
                $("#totalAmount").text("₱0.00");
            }
        });


        $(".order-btn").on("click", function () {
            const id = $(this).data("id");
            const name = $(this).data("name");
            const price = parseFloat($(this).data("price"));

            if (orderItems[id]) {
                orderItems[id].qty++;
                $("#qty-" + id).text(orderItems[id].qty);
            } else {
                orderItems[id] = { qty: 1, price: price };

                $("#emptyReceipt").remove();

                $("#receiptBody").append(`
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span>${name}</span>
                        <span>
                            <strong>x<span id="qty-${id}">1</span></strong>
                            ₱${price.toFixed(2)}
                        </span>
                    </div>
                `);

                $("#orderItemsInputs").append(`
                    <input type="hidden" name="OrderItems[${index}].ProductId" value="${id}" />
                    <input type="hidden" name="OrderItems[${index}].Quantity" id="input-qty-${id}" value="1" />
                    <input type="hidden" name="OrderItems[${index}].Price" value="${price}" />
                `);
                index++;
            }

            $("#input-qty-" + id).val(orderItems[id].qty);
            updateTotal();
        });

        function updateTotal() {
            let total = 0;
            for (const key in orderItems) {
                total += orderItems[key].qty * orderItems[key].price;
            }
            $("#totalAmount").text("₱" + total.toFixed(2));
            $("#PaymentAmount").val("₱" + total.toFixed(2));
        }

	</script>

}
