@using Cucina_De_Corazon.ViewModels
@model OrderViewModel
@{
	ViewData["Title"] = "NewOrder";
}
<div class="container mt-5 h-100 w-100">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }
	<div class="card shadow border-0 rounded-4" style="max-height:90% !important; min-height: 90%">
		<div class="w-100 bg-orange rounded-top position-relative">
			<h3 class="fw-bold text-white text-center m-3">New Order</h3>
			<div class="position-absolute top-0 start-0 pt-3 p-2">
				<div class="d-flex flex-row gap-2 text-white">
					<h5>Step</h5>
					<h5 id="Step">1</h5>
					<h5>of 4</h5>
				</div>
			</div>
			<div class="position-absolute top-0 end-0 pt-3 p-2">
				<div class="d-flex flex-row gap-2 text-white">
					<button class="btn btn-light fw-bold" id="btnBack" type="button" disabled>Back</button>
                    <button class="btn btn-light fw-bold" id="btnNext" type="button" disabled>Next</button>
				</div>
			</div>
		</div>
        @* Display PAGES *@
        <form asp-action="AddOrder" asp-controller="Order" method="post" class="h-100 w-100">
            <div class="p-4 h-100 w-100" id="pages">
                <!-- STEP 1 : ORDER / CUSTOMER -->
                <div id="step-1" class=" h-100 w-100">
                    <h4 class="mb-3">Customer Information</h4>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Customer Name</label>
                            <input class="form-control" asp-for="Order.CustomerName" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" asp-for="Order.Email"/>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Contact Number</label>
                            <input class="form-control" asp-for="Order.ContactNumber" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Alternate Contact</label>
                            <input class="form-control" asp-for="Order.AlternateContactNumber" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Address</label>
                            <textarea class="form-control" asp-for="Order.CustomerAddress"></textarea>
                        </div>
                    </div>
                </div>

                <!-- STEP 2 : EVENT DETAILS -->
                <div id="step-2" class="visually-hidden h-100 w-100">
                    <h4 class="mb-3">Event Details</h4>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Event Type</label>
                            <input class="form-control" asp-for="Order.EventDetails.EventType"/>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Theme</label>
                            <input class="form-control" asp-for="Order.EventDetails.Theme" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Event Date</label>
                            <input type="date" class="form-control" asp-for="Order.EventDetails.EventDate" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Event Time</label>
                            <input type="time" class="form-control" asp-for="Order.EventDetails.EventTime" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Event Address</label>
                            <textarea class="form-control" asp-for="Order.EventDetails.EventAddress"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Number of Pax</label>
                            <input class="form-control" type="number" step="1" asp-for="Order.NoPax" />
                        </div>
                    </div>
                </div>

                <!-- STEP 3 : ORDER PRODUCTS -->
                <div id="step-3" class="visually-hidden h-100 w-100">
                    <h4 class="mb-1">Order Products     -    By 5pax</h4>

                    <div class="row">
                        <!-- LEFT: Products -->
                        <div class="col-8 ps-1">
                            <div style="max-height: 65vh; overflow-y: auto; overflow-x: hidden">
                                <div class="">
                                    @{
                                        var category = Model.Products.Select(x => x.Category).Distinct();
										int count = 1;
                                    }
                                    <ul class="nav nav-tabs w-100" id="info">
                                    @foreach (var c in category)
                                    {
                                            <li class="nav-item">
                                                <a class="nav-link text-black @(count==1?"active": "")" aria-current="page" id="@(count++)">@c.CategoryName</a>
                                            </li>
                                    }
                                    </ul>
									@{
                                        count= 1;
                                    }
                                    <div id="content" class="p-2">
                                        @foreach (var c in category)
                                        {
                                            <div class="h-100 w-100 d-flex flex-wrap @(count == 1 ? "" : "visually-hidden")" id="@(count++)">
                                                @foreach (var p in Model.Products.Where(x => x.CategoryId == c.CategoryId))
                                                {
                                                    <div class="col-lg-3 col-md-4">
                                                        <div class="d-flex p-1 w-100 h-100">
                                                            <div class="card food-card shadow-sm w-100 h-100">
                                                                <img src="~/images/@(p.ProductName).png"
                                                                     class="card-img-top rounded-top"
                                                                     alt="@p.ProductName"
                                                                     style="height: 100px; object-fit: cover;">
                                                                <div class="card-body text-center d-flex flex-column justify-content-between">
                                                                    <div>
                                                                        <h5 class="card-title fw-bold">@p.ProductName</h5>
                                                                    </div>
                                                                    <div>
                                                                        <p class="card-text text-dark fw-semibold">₱@p.ProductPrice</p>
                                                                        <button type="button"
                                                                                data-bs-toggle="modal"
                                                                                data-bs-target="#AmountModal"
                                                                                class="btn btn-warning w-100 order-btn"
                                                                                data-id="@p.ProductId"
                                                                                data-name="@p.ProductName"
                                                                                data-price="@p.ProductPrice"
                                                                                data-imgsrc="@Url.Content($"~/images/{p.ProductName}.png")">
                                                                            Add
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- RIGHT: Receipt -->
                        <div class="col-4">
                            <div class="card shadow-sm">
                                <div class="card-header bg-dark text-white">
                                    <h5 class="mb-0">Order Summary</h5>
                                </div>

                                <div class="card-body p-2" id="receiptBody" style="max-height: 65vh; overflow-y: auto;">
                                    <p class="text-muted text-center" id="emptyReceipt">No items added</p>
                                </div>
                                <!-- Hidden inputs go here -->
                                <div id="orderItemsInputs">

                                </div>
                                <div class="card-footer">
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>Total</span>
                                        <span id="totalAmount">₱0.00</span>
                                    </div>
                                    <button class="btn btn-success w-100 mt-2" type="button" id="ResetOrder">Reset Items</button>
                                </div>
                            </div>
                            <div class="w-100">
                                <label class="form-label">Special Request</label>
                                <textarea class="form-control" asp-for="Order.SpecialRequest"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 4 : PAYMENT -->
                <div id="step-4" class="visually-hidden h-100 w-100">
                    <div class="m-0 p-0 position-relative">
                        <h4 class="mb-3">Payment</h4>

                        <div class="row g-3 h-100">
                            <div class="col-md-6">
                                <label class="form-label">Payment Method</label>
                                <select class="form-select" asp-for="Payment.PaymentMethod">
                                    <option>Cash</option>
                                    <option>Paymaya</option>
                                    <option>Gcash</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Reference Number</label>
                                <input class="form-control" asp-for="Payment.ReferenceNumber" />
                            </div>

                            <div class="col-md-6">
                                <div class="row p-0 m-0">
                                    <div class="col-md-12 px-0">
                                        <label class="form-label">Payment Amount</label>
                                        <input type="number" step="0.01" class="form-control" asp-for="Payment.PaymentAmount" id="PaymentAmount" />
                                    </div>
                                    <div class="col-md-6 px-0">
                                        <label class="form-label">Balance</label>
                                        <input type="text" readonly class="form-control bg-white text-black" id="PaymentBalance" />
                                    </div>
                                    <div class="col-md-6 pe-0">
                                        <label class="form-label text-white">eklog</label>
                                        <button class="btn btn-warning w-100" type="button" id="50-button">
                                            50%
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Payment Status</label>
                                <select class="form-select" asp-for="Payment.PaymentStatus">
                                    <option>Pending</option>
                                    <option>Paid</option>
                                </select>
                            </div>
                            <div class="col-12 d-flex justify-content-end">
                                <button type="button" id="ModalButton" class="btn btn-success mt-2 col-3">
                                    Confirm Order
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
	</div>
</div>
<div class="modal fade" id="AmountModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <div class="modal-header bg-orange text-white">
                <h5 class="modal-title">Select Amount</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body row">
                <div class="col-6">
                    <img id="ModalImg" class="w-100" style="max-height:220px ;object-fit: cover;" />
                </div>
                <div class="col-6">
                    <div class="row">
                        <input hidden type="number" id="ModalId" />
                        <h4 class="text-center" id="ModalName"></h4>
                        <div class="col-12">
                            <label class="form-label">Price</label>
                            <input class="form-control bg-white" readonly id="ModalPrice"/>
                        </div>
                        <div>
                            <label class="form-labe">Quantity</label>
                            <input class="form-control" type="number" step="1" id="ModalAmount"/>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" id="ModalSubmit" data-bs-dismiss="modal">
                    Submit
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
	<script>
		$(document).ready(function () {

			var currentPage = 1;
			var totalPages = $("#pages").children("div").length;

			updateButtons();

			$("#btnNext").on("click", function () {
				if (currentPage < totalPages) {
					showPage(currentPage + 1);
				}
			});

			$("#btnBack").on("click", function () {
				if (currentPage > 1) {
					showPage(currentPage - 1);
				}
			});

            function showPage(pageNumber) {
                $("#pages > div").addClass("visually-hidden");
                $("#step-" + pageNumber).removeClass("visually-hidden");
                $("#Step").text(pageNumber);
                currentPage = pageNumber;
                updateButtons();
            }

			function updateButtons() {
				$("#btnBack").prop("disabled", currentPage === 1);
				$("#btnNext").prop("disabled", currentPage === totalPages);
			}

		});

        let orderItems = {};
        let index = 0;
        $("#ResetOrder").on("click", function() {
            if (confirm("Are you sure you want to reset the order?")) {
                orderItems = {};
                index = 0;
                $("#receiptBody").empty();
                $("#receiptBody").html('<p class="text-muted text-center" id="emptyReceipt">No items added</p>');
                $("#orderItemsInputs").empty();
                $("#totalAmount").text("₱0.00");
            }
        });

        $(".order-btn").on("click", function () {
            const id = $(this).data("id");
            const name = $(this).data("name");
            const price = parseFloat($(this).data("price"));

            const img = $(this).data("imgsrc");

            var modalid = $("#ModalId");
            var modalimg = $("#ModalImg");
            var modalname = $("#ModalName");
            var modalprice = $("#ModalPrice");
            var modalamount = $("#ModalAmount");

            modalamount.val(null);
            modalid.val(null);

            modalid.val(id);
            modalname.text(name);
            modalprice.val(price);
            modalimg.attr("src", img);

            modalbutton = $("#ModalSubmit");
            modalbutton.data("id", id);
            modalbutton.data("name", name);
            modalbutton.data("price", price);

        })

        $("#ModalSubmit").on("click", function () {
            const id = $(this).data("id");
            const name = $(this).data("name");
            const price = parseFloat($(this).data("price"));
            const amount = parseFloat($("#ModalAmount").val());

            console.log(id, name, price, amount);

            if (orderItems[id]) {
                orderItems[id].qty += amount;
                $("#qty-" + id).text(orderItems[id].qty);
            } else {
                orderItems[id] = { qty: amount, price: price };
                    
                $("#emptyReceipt").remove();

                $("#receiptBody").append(`
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span>${name}</span>
                        <span>
                            <strong>x<span id="qty-${id}">${amount}</span></strong>
                            ₱${price.toFixed(2)}
                        </span>
                    </div>
                `);

                $("#orderItemsInputs").append(`
                    <input type="hidden" name="OrderItems[${index}].ProductId" value="${id}" />
                    <input type="hidden" name="OrderItems[${index}].Quantity" id="input-qty-${id}" value="${amount}" />
                    <input type="hidden" name="OrderItems[${index}].Price" value="${price}" />
                `);
                index++;
            }

            $("#input-qty-" + id).val(orderItems[id].qty);
            updateTotal();
        });

        $("#50-button").on("click", function () {
            // Get total text (₱1234.00)
            const totalText = $("#totalAmount").text();

            // Remove peso sign and parse
            const total = parseFloat(totalText.replace("₱", "")) || 0;

            const half = total * 0.5;

            $("#PaymentAmount").val(half.toFixed(2));
        });


        function updateTotal() {
            let total = 0;
            for (const key in orderItems) {
                total += orderItems[key].qty * orderItems[key].price;
            }
            $("#totalAmount").text("₱" + total.toFixed(2));
            $("#PaymentBalance").val(total.toFixed(2));
        }
        $(document).ready(function (){
            $("#info a").on("click", function () {
                var id = $(this).attr("id"); // 1,2,3,4

                // set active tab
                $("#info a").removeClass("active");
                $(this).addClass("active");

                // hide all content
                $("#content > div").addClass("visually-hidden");

                // show selected content
                $("#content > div[id='" + id + "']").removeClass("visually-hidden");
            });
        })
	</script>

}
