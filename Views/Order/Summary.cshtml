@model Cucina_De_Corazon.Models.Order;
@{
	ViewData["Title"] = "Order Summary";
}
<div class="container mt-5 h-100 w-100 d-flex flex-column gap-0">
    <div class="w-100 bg-orange rounded-top position-relative">
        <h3 class="fw-bold text-white text-center m-3">Order Summary</h3>
        <div class="position-absolute end-0 top-0 h-100 d-flex align-items-center pe-2">
            <a asp-action="Index" asp-controller="Records" type="button" class="text-decoration-none btn btn-light fw-bold">Confirm</a>
        </div>
    </div>
    <div class="card shadow border-0 rounded-top-0 rounded-4 p-2"
         style="max-height:70vh; overflow-y:auto; overflow-x:hidden;">
        
        <!-- Step 1 -->
        <div>
            <h3 class="text-center">Step 1 - Customer Info</h3>
            <div class="d-flex px-5">
                <table class="table table-bordered flex-grow-1">
                    <tr><td class="col-6">Name:</td><td>@Model.CustomerName</td></tr>
                    <tr><td>Email:</td><td>@Model.Email</td></tr>
                    <tr><td>Contact Number:</td><td>@Model.ContactNumber</td></tr>
                    <tr><td>Alternate Contact Number:</td><td>@Model.AlternateContactNumber</td></tr>
                    <tr><td>Customer Address:</td><td>@Model.CustomerAddress</td></tr>
                </table>
            </div>
        </div>

        <hr />

        <!-- Step 2 -->
        <div>
            <h3 class="text-center">Step 2 - Event Info</h3>
            <div class="d-flex px-5">
                <table class="table table-bordered flex-grow-1">
                    <tr><td class="col-6">Event Date:</td><td>@Model.EventDetails.EventDate</td></tr>
                    <tr><td>Event Time:</td><td>@Model.EventDetails.EventTime</td></tr>
                    <tr><td>Event Address:</td><td>@Model.EventDetails.EventAddress</td></tr>
                    <tr><td>Event Type:</td><td>@Model.EventDetails.EventType</td></tr>
                    <tr><td>Event Theme:</td><td>@Model.EventDetails.Theme</td></tr>
                </table>
            </div>
        </div>

        <hr />

        <!-- Step 3 -->
        <div>
            <h3 class="text-center">Step 3 - Food Items</h3>
            <div class="d-flex px-5">
                <table class="table table-bordered flex-grow-1">
                    <tr><td class="col-3">Product Name</td><td>Quantity</td><td>Price</td><td>Subtotal</td></tr>
                    @{
                        var vp = ViewBag.Products;
                        IEnumerable<Product> products = vp; 
                        var total = 0;
                    }
                    @foreach(var prods in Model.OrderProducts){
                        var sp = products.FirstOrDefault(x => x.ProductId == prods.ProductId).ProductPrice;
                        var price = double.Parse(sp);
                        var name = products.FirstOrDefault(x => x.ProductId == prods.ProductId).ProductName;
                        var subtotal = price * prods.Quantity;

                        total += (int)subtotal;

                        <tr><td>@name</td><td>@prods.Quantity</td><td>@price.ToString("N2")</td><td>@subtotal.ToString("N2")</td></tr>
                    }

                    <tr><td colspan="3" class="text-end">Total:</td><td>@total.ToString("N2")</td></tr>
                </table>
            </div>
        </div>

        <hr />

        <!-- Step 4 -->
        <div>
            <h3 class="text-center">Step 4 - Payment Info</h3>
            <div class="d-flex px-5">
                <table class="table table-bordered flex-grow-1">
                    <tr><td class="col-6">Payment Status</td><td>@Model.Payments.First().PaymentStatus</td></tr>
                    @foreach(var p in Model.Payments){
                        <tr><td>
                            amount: </td><td>@p.PaymentAmount</td></tr>
                    }
                    <tr><td>Balance: </td><td>@(Model.TotalAmount - Model.Payments.Sum(x => x.PaymentAmount))</td></tr>
                </table>
            </div>
        </div>

    </div>
</div>
