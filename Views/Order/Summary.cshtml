@model Cucina_De_Corazon.Models.Order;
@{
	ViewData["Title"] = "Order Summary";
}
<div class="container mt-5 h-100 w-100 d-flex flex-column gap-0">
    <div class="w-100 bg-orange rounded-top position-relative">
        <h3 class="fw-bold text-white text-center m-3">Order Summary</h3>
        <div class="position-absolute end-0 top-0 h-100 d-flex align-items-center pe-2">
            <a asp-action="Details" asp-controller="Records" asp-route-id="@Model.OrderId" type="button" class="text-decoration-none text-orange btn btn-light fw-bold">Confirm</a>
        </div>
    </div>
    <div class="card shadow border-0 rounded-top-0 rounded-4 p-2"
         style="max-height:70vh; overflow-y:auto; overflow-x:hidden;">
        
        <!-- Step 1 -->
        <div>
            <h3 class="text-center">Customer Info</h3>
            <div class="d-flex px-5">
                <table class="table table-bordered flex-grow-1">
                    <tr><td class="col-6 fw-bold">Name:</td><td>@Model.CustomerName</td></tr>
                    <tr><td class="col-6 fw-bold">Email:</td><td>@Model.Email</td></tr>
                    <tr><td class="col-6 fw-bold">Contact Number:</td><td>@Model.ContactNumber</td></tr>
                    <tr><td class="col-6 fw-bold">Alternate Contact Number:</td><td>@Model.AlternateContactNumber</td></tr>
                    <tr><td class="col-6 fw-bold">Customer Address:</td><td>@Model.CustomerAddress</td></tr>
                </table>
            </div>
        </div>

        <hr />

        <!-- Step 2 -->
        <div>
            <h3 class="text-center">Event Info</h3>
            <div class="d-flex px-5">
                <table class="table table-bordered flex-grow-1">
                    <tr><td class="col-6 fw-bold">Event Date:</td><td>@Model.EventDetails.EventDate</td></tr>
                    <tr><td class="col-6 fw-bold">Event Time:</td><td>@Model.EventDetails.EventTime</td></tr>
                    <tr><td class="col-6 fw-bold">Event Address:</td><td>@Model.EventDetails.EventAddress</td></tr>
                    <tr><td class="col-6 fw-bold">Event Type:</td><td>@Model.EventDetails.EventType</td></tr>
                    <tr><td class="col-6 fw-bold">Event Theme:</td><td>@Model.EventDetails.Theme</td></tr>
                </table>
            </div>
        </div>

        <hr />

        <!-- Step 3 -->
        <div>
            <h3 class="text-center">Food Items</h3>
            <div class="d-flex px-5">
                <table class="table table-bordered flex-grow-1">
                    <tr><td class="col-3 fw-bold">Product Name</td><td class="col-3 fw-bold">Quantity</td><td class="col-3 fw-bold">Price</td><td class="col-3 fw-bold">Subtotal</td></tr>
                    @{
                        var vp = ViewBag.Products;
                        IEnumerable<Product> products = vp; 
                        var total = 0;
                    }
                    @foreach(var prods in Model.OrderProducts){
                        var sp = products.FirstOrDefault(x => x.ProductId == prods.ProductId).ProductPrice;
                        var price = double.Parse(sp);
                        var name = products.FirstOrDefault(x => x.ProductId == prods.ProductId).ProductName;
                        var subtotal = price * prods.Quantity;

                        total += (int)subtotal;

                        <tr><td>@name</td><td>@prods.Quantity</td><td>@price.ToString("N2")</td><td>@subtotal.ToString("N2")</td></tr>
                    }

                    <tr><td colspan="3" class="text-end fw-bold">Total:</td><td>@total.ToString("N2")</td></tr>
                </table>
            </div>
        </div>

        <hr />

        <!-- Step 4 -->
        <div>
            <h3 class="text-center">Payment Info</h3>
            <div class="d-flex px-5">
                <table class="table table-bordered flex-grow-1">
                    <tr><td class="col-6 fw-bold">Payment Status</td><td>@Model.Payments.First().PaymentStatus</td></tr>
                    <tr><td colspan="2" class="text-center fw-bold">Payments Made</td></tr>
                    @{
						var totalPayments = Model.Payments.Sum(x => x.PaymentAmount);
                        var balance = (Model.TotalAmount - totalPayments) < 0 ? 0 : Model.TotalAmount - totalPayments;
						double change = balance > 0 ? 0.00 : (double)(Model.TotalAmount - totalPayments);
					}
                    <tr>
                        <td colspan="2" class="p-0">
                            <div class="h-100 w-100">
                                <table class="table table-bordered m-0">
                                    <tr><td class="col-6 fw-bold">Date Paid</td><td class="col-6 fw-bold">Amount</td></tr>
                                    @foreach(var p in Model.Payments){
                                        <tr><td>@(Convert.ToDateTime(p.PaymentDate).ToString("dd/MM/yyyy"))</td><td>@p.PaymentAmount</td></tr>
                                    }
                                    <tr><td class="col-6 fw-bold">Total Payments:</td><td>@totalPayments</td></tr>
                                </table>
                            </div>
                        </td>
                    </tr>
                    
                    <tr><td class="col-6 fw-bold">Amount: </td><td>@total.ToString("0.00")</td></tr>
                    <tr><td class="col-6 fw-bold">Balance: </td><td>@balance</td></tr>
                    <tr><td class="col-6 fw-bold">Change: </td><td>@change.ToString("0.00")</td></tr>
                </table>
            </div>
        </div>

    </div>
</div>
