@{
    ViewData["Title"] = "Login";
}

<div class="container h-100 w-100">
    <div class="h-100 w-100 d-flex justify-content-center align-items-center">
        <div class="col-md-8 p-0 overflow-hidden">
            <div class="card shadow-sm bg-orange">
                <div class="card-body p-0 row">
                    <div class="col-md-5 d-flex overflow-hidden justify-content-center align-items-center px-2">
                        <img class="h-50 z-1 position-absolute rounded-circle" src="~/images/logo.png" style="backdrop-filter:blur(1px)"/>
                        <img class="flex-grow-1 object-fit-cover" style="max-height: 60vh;" src="~/images/bg.png" />
                    </div>
                    <div class="col-md-7 py-5 px-5">
                        <div class="h-100 w-100 p-4" style="background: #f17c2c !important">
                            <h3 class="text-center mb-4 fw-bold text-white">Login</h3>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger">@ViewBag.Error</div>
                            }

                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-success">@TempData["Success"]</div>
                            }

                            <form method="post" asp-action="Login">
                                <div class="mb-3">
                                    <label for="username" class="form-label text-white">Username</label>
                                    <input type="text" name="username" class="form-control shadow" id="username" required />
                                </div>
                                <div class="mb-3">
                                    <label for="password" class="form-label text-white">Password</label>
                                    <input type="password" name="password" class="form-control shadow" id="password" required />
                                </div>
                                <div class="d-flex justify-content-center mt-5">
                                    <button type="submit" class="btn text-orange fw-bold bg-white px-5">
                                        Login
                                    </button>
                                </div>
                            </form>

                            @* <p class="mt-3 text-center">
                                Don't have an account? <a asp-action="Register" class="text-white">Register here</a>
                            </p> *@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
