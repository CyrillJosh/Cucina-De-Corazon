@{
    ViewData["Title"] = "Create Staff Account";
}

<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow border-0 rounded-4 p-4 col-md-7 bg-orange position-relative">
        <div class="position-absolute end-0 top-0">
            <a href="/User" class="btn btn-sm bg-transparent text-white rounded-0 rounded-start m-3">
                <h4>
                    x
                </h4>
            </a>
        </div>
        <h2 class="fw-bold mb-1 text-center text-white">Create New Staff Account</h2>

        <form id="createStaffForm" class="card px-4 py-2" style="background: #f17c2c">
            <h3 class="text-white mb-1 text-center">Person</h3>
            <div class="mb-1">
                <label class="form-label fw-semibold text-white">Full Name</label>
                <input type="text" name="fullName" class="form-control rounded-3" placeholder="Enter full name" required />
            </div>

            <div class="mb-1">
                <label class="form-label fw-semibold text-white">Email</label>
                <input type="email" name="email" class="form-control rounded-3" placeholder="Enter email (optional)" />
            </div>

			<hr class="my-4 border-white text-white" />
            <h3 class="text-white mb-1 text-center">Account</h3>
            <div class="mb-1">
                <label class="form-label fw-semibold text-white">Username</label>
                <input type="text" name="username" class="form-control rounded-3" placeholder="Choose a username" required />
            </div>

            <div class="mb-1">
                <label class="form-label fw-semibold text-white">Password</label>
                <input type="password" name="password" class="form-control rounded-3" placeholder="Enter password" required />
            </div>

            <div class="text-center mt-4">
                <button type="submit" class="btn px-5 fw-bold bg-white text-orange">Add Staff</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("createStaffForm").addEventListener("submit", async (e) => {
            e.preventDefault();

            const formData = new FormData(e.target);

            const res = await fetch("/User/CreateStaff", {
                method: "POST",
                body: formData
            });

            const data = await res.json();

            if (data.success) {
                alert("✅ " + data.message);
                e.target.reset();
            } else {
                alert("⚠️ " + data.message);
            }
        });
    </script>

    <style>
        .text-orange {
            color: #f57c1f;
        }

        .btn-orange {
            background-color: #f57c1f;
            color: white;
            border: none;
            transition: 0.2s;
        }

            .btn-orange:hover {
                background-color: #e36e14;
            }
    </style>
}
