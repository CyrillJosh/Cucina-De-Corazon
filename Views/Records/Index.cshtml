@using Cucina_De_Corazon.ViewModels
@model Records
@{
    ViewData["Title"] = "Bills";
}

<div class="container mt-5">
    <div class="card shadow border-0 rounded-4 p-4">
    <h2 class="text-center mb-4 fw-bold">Records</h2>

    @if (!Model.Orders.Any())
    {
        <div class="alert alert-info text-center rounded-3">No Records found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="bg-orange text-white" style="position: sticky; top: 0; z-index: 1; border-collapse: separate; border-spacing: 0px ;border: 1px solid black; border-radius: 5px;">
                    <tr class="text-white">
                        <th>Date</th>
                        <th>Ordered by</th>
                        <th>Address</th>
                        <th>Total</th>
                        <th>Balance</th>
                        <th>Amount</th>
                        <th>Reference Number</th>
                        <th>Status</th>
                        <th>Actions</th>
                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Orders)
                    {
                        <tr>
                            <td class="fw-semibold">@o.EventDetails.EventDate.ToString("yyyy-MM-dd")</td>
                            <td>@o.CustomerName</td>
                            <td>@o.CustomerAddress</td>
                                <td>
                                    ₱@(
                                    o.OrderProducts.Sum(x =>
                                    x.Quantity * Convert.ToInt32(Model.Products.First(y => y.ProductId == x.ProductId).ProductPrice)
                                    ).ToString("N2")
                                                        )
                        </td>
                        <td>
                           
                                    @(o.OrderProducts.Sum(x =>
                                    x.Quantity * Convert.ToInt32(Model.Products.First(y => y.ProductId == x.ProductId).ProductPrice)
                                    ) - o.Payments.PaymentAmount)
                        </td>
                        <td>
                            @o.Payments.PaymentAmount
                        </td>
                        <td>@(o.Payments.PaymentMethod == "Cash" ? "Cash" : o.Payments.ReferenceNumber??"-")</td>
                        <td>@o.Payments.PaymentStatus</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@o.OrderId"
                                   class="btn btn-warning btn-sm text-white fw-bold">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
</div>
