@using Cucina_De_Corazon.ViewModels
@model Records
@{
    ViewData["Title"] = "Bills";
}

<div class="container mt-5">
    <div class="card shadow border-0 rounded-4 p-4">
    <h2 class="text-center mb-4 fw-bold">Records</h2>
    @if (Model?.Orders == null || !Model.Orders.Any())
    {
        <div class="alert alert-info text-center rounded-3">No Records found.</div>
    }
    else
    {
        <table class="table table-bordered border-2 border-black">
            <thead>
                <tr class="bg-orange  text-white fw-bold" style="border-color: black">
                    <td>Event date</td>
                    <td>Customer Name</td>
                    <td>Event Address</td>
                    <td>Total</td>
                    <td>Balance</td>
                    <td>Amount Paid</td>
                    <td>Status</td>
                    <td></td>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders)
                {
                    var paidAmount = o.Payments?.Sum(x => x.PaymentAmount) ?? 0;
                    var balance = o.TotalAmount - paidAmount;
                    var status = o.Payments?.FirstOrDefault()?.PaymentStatus ?? "No Payment";

                    <tr>
                        <td class="fw-semibold">
                            @(o.EventDetails?.EventDate.ToString("yyyy-MM-dd") ?? "-")
                        </td>
                        <td>@o.CustomerName</td>
                        <td>@o.EventDetails?.EventAddress</td>
                        <td>₱@o.TotalAmount</td>
                        <td>₱@balance</td>
                        <td>₱@paidAmount</td>
                        <td>@status</td>

                        <td>
                            <a asp-action="Details" asp-route-id="@o.OrderId"
                               class="btn btn-warning btn-sm text-white fw-bold">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    </div>
</div>
