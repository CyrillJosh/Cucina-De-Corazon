@using Cucina_De_Corazon.ViewModels
@model OrderViewModel
@{
    ViewData["Title"] = "Bill Details";
}
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">

            <div class="modal-header bg-orange text-white">
                <h5 class="modal-title">Add Payment</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="AddPayment" asp-controller="Records" method="post">
                <div class="modal-body">

                    <!-- REQUIRED: OrderId -->
                    <input type="hidden" name="OrderId" value="@Model.Order.OrderId" />

                    <!-- Payment Method -->
                    <div class="mb-3 visually-hidden">
                        <label class="form-label">Payment Method</label>
                        <select class="form-select" name="PaymentMethod" required>
                            <option value="-">-</option>
                            <option value="Cash">Cash</option>
                            <option value="Gcash">Gcash</option>
                            <option value="Paymaya">Paymaya</option>
                        </select>
                    </div>

                    <!-- Reference Number (conditional) -->
                    <div class="mb-3 visually-hidden">
                        <label class="form-label">Reference Number</label>
                        <input class="form-control"
                               name="ReferenceNumber"
                               placeholder="Optional for Cash" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Balance</label>
                        <input type="number"
                               step="1"
                               class="form-control"
                               value="@(Model.Order.TotalAmount - Model.Order.Payments.Sum(x => x.PaymentAmount))"
                               id="Balance"
                               readonly />
                    </div>
                    <!-- Amount -->
                    <div class="mb-3">
                        <label class="form-label">Payment Amount</label>
                        <input type="number"
                               step="1"
                               class="form-control"
                               name="PaymentAmount"
                               id="Amount"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Change</label>
                        <input type="number"
                               step="1"
                               class="form-control"
                               name="Change"
                               id="Amount"
                               readonly />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Save Payment
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<div class="container mt-5 position-relative">
    <div class="w-100 position-relative">
        <h2 class="text-center mb-4 fw-bold text-orange">Bill Details</h2>
        <div class="d-flex  position-absolute end-0 top-0 gap-2">
            <a asp-action="Summary" asp-controller="Order" asp-route-id="@Model.Order.OrderId"
                    class="bg-orange btn text-white">
                View Reciept
            </a>
            <button type="button"
                    class="bg-orange btn text-white @(Model.Order.Payments.FirstOrDefault().PaymentStatus == "Fully Paid"? "hidden" : "")"
                    data-bs-toggle="modal"
                    data-bs-target="#paymentModal">
                Update Payment
            </button>
        </div>

    </div>

    <div class="w-100 mb-3">
        <div class="w-100 d-flex gap-2">
            <div class="bg-white flex-grow-1 p-3 rounded-3">
                <table class="table-bordered h-100 w-100">
                    <thead>
                        <tr>
						    <th class="fw-semibold me-3 ps-2 bg-orange text-white" colspan="2">Customer Details:</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-semibold me-3 ps-2">Customer Name:</td>
						    <td class="ps-2">@Model.Order.CustomerName</tdcla>
                        </tr>
                        <tr>
                            <td class="fw-semibold me-3 ps-2">Customer Address:</td>
                            <td class="ps-2">@Model.Order.CustomerAddress</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold me-3 ps-2">Contact #:</td>
                            <td class="ps-2">@Model.Order.ContactNumber</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold me-3 ps-2">Alternate Contact #:</td>
                            <td class="ps-2">@Model.Order.AlternateContactNumber</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="bg-white flex-grow-1 p-3 rounded-3">
                <table class="table-bordered h-100 w-100">
                    <thead>
                        <tr>
						    <th class="fw-semibold me-3 ps-2 bg-orange text-white" colspan="2">Event Details:</th>
                        </tr>
                    </thead>
                    <tbody>
                       <tr>
                            <td class="fw-semibold me-3 ps-2">Event Date:</td>
                            <td class="ps-2">@Model.Order.EventDetails.EventDate</td>
                       </tr>
                       <tr>
                            <td class="fw-semibold me-3 ps-2">Event Time:</td>
                            <td class="ps-2">@Model.Order.EventDetails.EventTime</td>
                       </tr>
                       <tr>
                            <td class="fw-semibold me-3 ps-2">Event Type:</td>
                            <td class="ps-2">@Model.Order.EventDetails.EventType</td>
                       </tr>
                       <tr>
                            <td class="fw-semibold me-3 ps-2">Event Address:</td>
                            <td class="ps-2">@Model.Order.EventDetails.EventAddress</td>
                       </tr>
                       <tr>
                            <td class="fw-semibold me-3 ps-2">Event Theme:</td>
                            <td class="ps-2">@Model.Order.EventDetails.Theme</td>
                       </tr>
                    </tbody>
                </table>
            </div>
            <div class="bg-white flex-grow-1 p-3 rounded-3">
                <table class="table-bordered h-100 w-100">
                    <thead>
                    <tr>
                        <th class="fw-semibold me-3 ps-2 bg-orange text-white" colspan="2">Payment Details:</th>
                    </tr>
                </thead>
                    <tbody>
                    <tr>
                        <td class="fw-semibold me-3 ps-2">Status:</td>
                        <td class="ps-2">@Model.Order.Payments.LastOrDefault().PaymentStatus</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold me-3 ps-2">Paid Amount:</td>
                        <td class="ps-2">@Model.Order.Payments.Sum(x => x.PaymentAmount)</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold me-3 ps-2">Balance:</td>
                        <td class="ps-2">@(Model.Order.TotalAmount - Model.Order.Payments.Sum(x => x.PaymentAmount))</td>
                    </tr>
                    <tr>
                        <td class="fw-semibold me-3 ps-2">Total:</td>
                        <td class="ps-2">@Model.Order.TotalAmount</td>
                    </tr>
                </tbody>
                </table>
            </div>
        </div>
    </div>
