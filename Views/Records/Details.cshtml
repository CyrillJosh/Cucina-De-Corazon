    @if (!Model.Order.OrderProducts.Any())
    {
        <div class="alert alert-info text-center rounded-3">No orders for this bill.</div>
    }
    else
    {
        <div class="card shadow-sm mb-3 rounded-3">
            <div class="card-body p-3">
                <div class="table-responsive" style="max-height: 40vh; overflow-y: auto;">
                    <table class="table table-bordered mb-0">
                        <thead class="bg-orange text-white"
                               style="position: sticky; top: 0; z-index: 10;">
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var product in Model.Order.OrderProducts)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @Model.Products.FirstOrDefault(x => x.ProductId == product.ProductId).ProductName
                                    </td>
                                    <td>
                                        ₱@Model.Products.FirstOrDefault(x => x.ProductId == product.ProductId).ProductPrice
                                    </td>
                                    <td>@product.Quantity</td>
                                    <td>
                                        ₱@(Convert.ToInt32(Model.Products.FirstOrDefault(x => x.ProductId == product.ProductId).ProductPrice) * product.Quantity)
                                    </td>
                                </tr>
                            }

                            <tr>
                                <td colspan="3" class="fw-bold text-end">Total:</td>
                                <td class="fw-bold">₱@Model.Order.TotalAmount</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
@section Scripts{
    <script>
         $(document).on("input","#Amount" ,function (){
            var change = $("#Balance").val() - $("this").val()
            $("#Change").val(change <= 0 ? 0: change)
        })
    </script>
}