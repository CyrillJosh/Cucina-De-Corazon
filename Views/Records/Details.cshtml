@using Cucina_De_Corazon.ViewModels
@model OrderViewModel
@{
    ViewData["Title"] = "Bill Details";
}
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">

            <div class="modal-header bg-orange text-white">
                <h5 class="modal-title">Add Payment</h5>
                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="AddPayment" asp-controller="Records" method="post">
                <div class="modal-body">

                    <!-- REQUIRED: OrderId -->
                    <input type="hidden" name="OrderId" value="@Model.Order.OrderId" />

                    <!-- Payment Method -->
                    <div class="mb-3">
                        <label class="form-label">Payment Method</label>
                        <select class="form-select" name="PaymentMethod" required>
                            <option value="Cash">Cash</option>
                            <option value="Gcash">Gcash</option>
                            <option value="Paymaya">Paymaya</option>
                        </select>
                    </div>

                    <!-- Reference Number (conditional) -->
                    <div class="mb-3">
                        <label class="form-label">Reference Number</label>
                        <input class="form-control"
                               name="ReferenceNumber"
                               placeholder="Optional for Cash" />
                    </div>

                    <!-- Amount -->
                    <div class="mb-3">
                        <label class="form-label">Payment Amount</label>
                        <input type="number"
                               step="0.01"
                               class="form-control"
                               name="PaymentAmount"
                               required />
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Save Payment
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<div class="container mt-5 position-relative">
    <div class="w-100 position-relative">
        <h2 class="text-center mb-4 fw-bold text-orange">Bill Details</h2>
        <button type="button"
                class="bg-orange btn text-white position-absolute end-0 top-0 @(Model.Order.Payments.FirstOrDefault().PaymentStatus == "Paid"? "hidden" : "")"
                data-bs-toggle="modal"
                data-bs-target="#paymentModal">
            Update Payment
        </button>
    </div>

