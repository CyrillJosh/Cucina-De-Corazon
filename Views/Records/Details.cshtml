@using Cucina_De_Corazon.ViewModels
@model OrderViewModel
@{
    ViewData["Title"] = "Bill Details";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 fw-bold  text-orange">Bill Details</h2>

    <div class="mb-3 text-center">
        <p class="mb-1 fw-semibold">Ordered by: @Model.Order.CustomerName</p>
        <p class="mb-0 text-muted">Email: @Model.Order.Email</p>
        <p class="mb-0 text-muted">Contact #: @Model.Order.ContactNumber</p>
        <p class="mb-0 text-muted">Contact #: @Model.Order.AlternateContactNumber</p>
    </div>

    <p class="text-center fs-5 fw-semibold">
        Total: ₱@(
        Model.Order.OrderProducts.Sum(x =>
        x.Quantity * decimal.Parse(
        Model.Products.First(y => y.ProductId == x.ProductId).ProductPrice
        )
        ).ToString("N2")
                )
    </p> 
@*     @if (Model.Order.Payments.PaymentStatus == "Pending")
    {
        <div class="text-center my-4">
            <form asp-action="ConfirmBill" asp-route-id="@Model.Order.OrderId" method="post">
                <button type="submit" class="btn btn-success fw-bold px-4">
                    Confirm Order
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-success text-center mt-4 rounded-3">
            This order has been <strong>confirmed</strong>.
        </div>
    } *@

    @if (!Model.Order.OrderProducts.Any())
    {
        <div class="alert alert-info text-center rounded-3">No orders for this bill.</div>
    }
    else
    {
        <div class="card shadow-sm mb-3 rounded-3">
            <div class="card-header fw-bold text-orange">
                Order ID: @Model.Order.OrderId
                @if (string.IsNullOrEmpty(Model.Order.EventDetails.EventDate.ToString()))
                {

                    <span class="float-end">Reserved: @Model.Order.EventDetails.EventDate.ToString("yyyy-MM-dd")</span>
                }
            </div>

            <div class="card-body">
                <table class="table table-bordered mb-0">
                    <thead class="bg-orange text-white" style="position: sticky; top: 0; z-index: 1; border-collapse: separate; border-spacing: 0px ;border: 1px solid black; border-radius: 5px;">
                        <tr class="text-white">
                            <th>Product</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Order.OrderProducts)
                        {
                            <tr>
                                <td class="fw-semibold">@Model.Products.FirstOrDefault(x => x.ProductId == product.ProductId)</td>
                                <td>₱@Model.Products.FirstOrDefault(x => x.ProductId == product.ProductId).ProductPrice</td>
                                <td>@product.Quantity</td>
                                <td>₱@(Convert.ToInt32(Model.Products.FirstOrDefault(x => x.ProductId == product.ProductId).ProductPrice) * product.Quantity)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
