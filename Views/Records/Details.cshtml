    <div class="text-center">
        <p class="mb-1 fw-semibold">Ordered by: @Model.Order.CustomerName</p>
        <p class="mb-0 text-muted">Email: @Model.Order.Email</p>
        <p class="mb-0 text-muted">Contact #: @Model.Order.ContactNumber</p>
        <p class="mb-0 text-muted">Alternate Contact #: @Model.Order.AlternateContactNumber</p>
        <p class="mb-0 text-muted">Amount Paid: @Model.Order.Payments.Sum(x => x.PaymentAmount)</p>
        <p class="mb-0 text-muted">Status: @(Model.Order.TotalAmount <= Model.Order.Payments.Sum(x => x.PaymentAmount)?"Paid":"Unpaid")</p>
    </div>

    <p class="text-center fs-5 fw-semibold">
