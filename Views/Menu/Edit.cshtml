@model Cucina_De_Corazon.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="container d-flex justify-content-center mt-3" style="max-height: 87vh;">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden"
         style="max-width: 520px; width: 100%;">

        <!-- ORANGE HEADER -->
        <div class="p-4 text-center" style="background:#f57c1f;">
            <h3 class="fw-bold text-white mb-1">Edit Product</h3>
            <p class="text-white-50 mb-0" style="font-size: 0.95rem;">
                Update product information below
            </p>
        </div>

        <!-- WHITE BODY -->
        <div class="card-body bg-white p-4 overflow-auto" style="max-height: 75vh;">

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="ProductId" />

                <!-- Name -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Name</label>
                    <input asp-for="ProductName" class="form-control rounded-3 shadow-sm" required />
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Description</label>
                    <textarea asp-for="ProductDescription"
                              class="form-control rounded-3 shadow-sm"
                              rows="3" required></textarea>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark">Price</label>
                    <div class="input-group shadow-sm rounded-3 overflow-hidden">
                        <span class="input-group-text fw-bold text-white" style="background:#f57c1f;">₱</span>
                        <input asp-for="ProductPrice" class="form-control border-0" />
                    </div>
                </div>

                <!-- Category -->
                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark">Category</label>
                    <select asp-for="CategoryId"
                            class="form-select rounded-3 shadow-sm"
                            asp-items="ViewBag.Categories" required>
                        <option value="">Select Category</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="d-grid gap-2">
                    <button type="submit"
                            class="btn fw-bold rounded-3 py-2 text-white"
                            style="background:#f57c1f;">
                        Update Product
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-dark fw-bold rounded-3 py-2">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>
