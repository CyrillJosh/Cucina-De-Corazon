@model Cucina_De_Corazon.Models.Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="container mt-3 d-flex justify-content-center">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden"
         style="max-width:520px; width:100%; background:#f57c1f;">

        <!-- Header -->
        <div class="p-4 text-center">
            <h3 class="fw-bold text-white mb-1">Product Details</h3>
        </div>

        <!-- Body -->
        <div class="bg-white p-4 rounded-top-4" style="margin-top:-10px;">

            <!-- Product Image -->
            <div class="d-flex justify-content-center mb-4">
                <div class="p-2 rounded-4 shadow-sm bg-white"
                     style="width: 180px; height: 180px; display:flex; align-items:center; justify-content:center;">
                    <img src="~/images/@(Model.ProductName).png"
                         class="img-fluid"
                         style="max-height: 200px; object-fit: contain;"
                         alt="Product Image" />
                </div>
            </div>

            <!-- Name + Category -->
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <div class="p-3 rounded-4 shadow-sm">
                        <small class="text-black-50 fw-semibold">Name</small>
                        <div class="text-black fw-bold">@Model.ProductName</div>
                    </div>
                </div>

                <div class="col-6">
                    <div class="p-3 rounded-4 shadow-sm">
                        <small class="text-black-50 fw-semibold">Category</small>
                        <div class="text-black fw-bold">@Model.Category?.CategoryName</div>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <div class="p-3 rounded-4 shadow-sm">
                    <small class="text-black-50 fw-semibold">Description</small>
                    <p class="text-black mb-0 mt-1" style="line-height: 1.4;">
                        @Model.ProductDescription
                    </p>
                </div>
            </div>

            <!-- Price -->
            <div class="mb-4">
                <div class="p-3 rounded-4 shadow-sm d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-black-50 fw-semibold">Price</small>
                        <div class="text-black fw-bold">₱@Model.ProductPrice</div>
                    </div>

                    <span class="badge rounded-pill px-3 py-2"
                          style="background:#f57c1f; color:white; font-size:0.9rem;">
						@(Model.IsAvailable ? "Available" : "Not Available")
                    </span>
                </div>
            </div>

            <!-- Optional Picture -->
            @if (Model.ProductPicture != null)
            {
                <div class="mb-4">
                    <div class="p-3 rounded-4 bg-black shadow-sm">
                        <small class="text-white-50 fw-semibold">Uploaded Picture</small>
                        <div class="mt-2">
                            <img src="~/images/@Model.ProductPicture"
                                 class="img-fluid rounded-4 shadow"
                                 style="max-height: 250px; width:100%; object-fit: cover;"
                                 alt="Uploaded Picture" />
                        </div>
                    </div>
                </div>
            }

            <!-- Button -->
            <div class="d-grid">
                <a asp-action="Index"
                   class="btn fw-bold rounded-4 py-2"
                   style="background:#f57c1f; color:white;">
                    ← Back to List
                </a>
            </div>

        </div>
    </div>
</div>
