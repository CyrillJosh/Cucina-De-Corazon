@using System.Text.Json
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cucina_De_Corazon</title>
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet">

    <link rel="manifest" href="~/manifest.json" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/flatpikr.css"/>

    <style>
        .text-underline-orange {
            border-bottom-color: #f17c2c;
            border-bottom-width: 3px;
            border-bottom-style: solid;
        }
    </style>
</head>
@{
    var role = Context.Session.GetString("Role");
    var sessionUser = Context.Session.GetString("User") ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    // var categoriesJson = Context.Session.GetString("Categories");
    // List<Category> categories = null;    
    // if (!string.IsNullOrEmpty(categoriesJson))
    // {
    //     categories = JsonSerializer.Deserialize<List<Category>>(categoriesJson);
    // }
}
<body class="d-flex flex-column vh-100 vw-100 overflow-hidden" style="background: #ECE0D8">
    <header style="background: #212120; display: @(string.IsNullOrEmpty(sessionUser)? "none" : "block" ) ">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <div class="w-100 d-flex flex-row justify-content-between px-5 align-items-center" style="font-size: 1.25rem; font-weight: bold;">
                    <div class="">
						<img src="~/images/logo.png" class="me-2" style="height: 5rem; width: auto; transform: scale(1.5)" />
                    </div> 
                    @if (role == "Admin")
                    {
                        <a class=" text-decoration-none text-white @(currentController == "Records"?"text-underline-orange":"")" href="/Records">Records</a>
                        <a class=" text-decoration-none text-white @(currentController == "Menu" ? "text-underline-orange" : "")" href="/Menu">Menu</a>
                        <a class=" text-decoration-none text-white @(currentController == "Order" ? "text-underline-orange" : "")" href="/Order">Add Order</a>
                        <a class=" text-decoration-none text-white @(currentController == "Event" ? "text-underline-orange" : "")" href="/Event/Calendar">Schedules</a>
                        <a class=" text-decoration-none text-white @(currentController == "User" ? "text-underline-orange" : "")" href="/User">User Management</a>
                    }
                    else
                    {
                        <a class=" text-decoration-none text-white @(currentController == "Records" ? "text-underline-orange" : "")" href="/Records">Records</a>
                        <a class=" text-decoration-none text-white @(currentController == "Order" ? "text-underline-orange" : "")" href="/Order">Add Order</a>
                        <a class=" text-decoration-none text-white @(currentController == "Event" ? "text-underline-orange" : "")" href="/Event/Calendar">Schedules</a>
                    }
                    @if (!string.IsNullOrEmpty(sessionUser))
                    {
                        <a class="text-decoration-none text-white" asp-controller="User" asp-action="Logout">Logout</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="flex-grow-1 overflow-y-scroll">
            @RenderBody()
    </div>
    @if (TempData["AuthMessage"] != null)
    {
        <div class="modal fade" id="authModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow rounded-4">

                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i>
                            Unauthorized Access
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body text-center py-4">
                        <i class="fa-solid fa-ban text-danger mb-3" style="font-size: 50px;"></i>
                        <p class="fw-semibold">@TempData["AuthMessage"]</p>
                    </div>

                    <div class="modal-footer justify-content-center">
                        <button class="btn btn-primary px-4" data-bs-dismiss="modal">
                            OK
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }


  @*   <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Cucina_De_Corazon - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer> *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/calendar.js"></script>
	<script src="~/js/flatpikr.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (TempData["AuthMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var modal = new bootstrap.Modal(document.getElementById('authModal'));
                modal.show();
            });
            self.addEventListener('fetch', (event) => {
              // Basic listener to satisfy PWA requirements
            });
            if ('serviceWorker' in navigator) {
              window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js');
              });
            }
        </script>
    }
</body>
</html>
